@model IEnumerable<Appointment>
@{ ViewData["Title"] = "Записи"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Записи пацієнтів</h2>
    <a asp-action="Create" class="btn btn-success">+ Додати запис</a>
</div>
<table class="table table-bordered table-striped bg-white">
    <thead>
        <tr><th>ID</th><th>Лікар</th><th>Пацієнт</th><th>Дата/Час</th><th>Статус</th><th>Дії</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.Doctor?.Name</td>
                <td>@item.PatientName</td>
                <td>@item.AppointmentDate</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>