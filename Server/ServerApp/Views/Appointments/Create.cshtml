@model Appointment
@{ ViewData["Title"] = "Додати запис"; }

<h2>Новий запис</h2>
<form asp-action="Create" method="post" class="card p-4 bg-white" style="max-width: 500px;">
    <div class="mb-3">
        <label class="form-label">Лікар</label>
        <select asp-for="DoctorID" asp-items="ViewBag.Doctors" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Слот графіка</label>
        <select asp-for="ScheduleID" asp-items="ViewBag.Schedules" class="form-select">
            <option value="">-- Без прив'язки --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Ім'я пацієнта</label>
        <input asp-for="PatientName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Дата та час прийому</label>
        <input asp-for="AppointmentDate" class="form-control" placeholder="2026-11-25 14:00" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Статус</label>
        <select asp-for="Status" class="form-select">
            <option value="Pending">Pending</option>
            <option value="Confirmed">Confirmed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Назад</a>
</form>