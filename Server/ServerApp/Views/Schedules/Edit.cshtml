@model Schedule
@{ ViewData["Title"] = "Редагувати графік"; }

<h2>Редагувати слот</h2>
<form asp-action="Edit" method="post" class="card p-4 bg-white" style="max-width: 500px;">
    <input type="hidden" asp-for="ID" />
    <div class="mb-3">
        <label class="form-label">Лікар</label>
        <select asp-for="DoctorID" asp-items="ViewBag.Doctors" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Дата</label>
        <input asp-for="Date" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Часовий слот</label>
        <input asp-for="TimeSlot" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Статус</label>
        <select asp-for="Status" class="form-select">
            <option value="Available">Available</option>
            <option value="Booked">Booked</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Оновити</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Назад</a>
</form>