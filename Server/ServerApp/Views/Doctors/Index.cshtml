@model IEnumerable<Doctor>
@{ ViewData["Title"] = "Лікарі"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Лікарі</h2>
    <a asp-action="Create" class="btn btn-success">+ Додати лікаря</a>
</div>
<table class="table table-bordered table-striped bg-white">
    <thead>
        <tr><th>ID</th><th>Ім'я</th><th>Email</th><th>Дії</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>