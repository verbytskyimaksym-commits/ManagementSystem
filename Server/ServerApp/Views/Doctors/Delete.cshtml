@model Doctor
@{ ViewData["Title"] = "Видалити лікаря"; }

<h2>Видалити лікаря?</h2>
<div class="card p-4 bg-white" style="max-width: 500px;">
    <p>Ви впевнені, що хочете видалити <strong>@Model.Name</strong> (@Model.Email)?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ID" />
        <button type="submit" class="btn btn-danger">Видалити</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>