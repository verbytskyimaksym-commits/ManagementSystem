<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.LoginPage"
             Title="Вхід лікаря">
    <VerticalStackLayout Padding="30" Spacing="15" MaximumWidthRequest="400" VerticalOptions="Center">
        <Label Text="Система медичних записів" FontSize="24" HorizontalOptions="Center" FontAttributes="Bold" />
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
        <Entry Placeholder="Пароль" Text="{Binding Password}" IsPassword="True" />
        <Label Text="{Binding ErrorMessage}" TextColor="Red" />
        <Button Text="Увійти" Command="{Binding LoginCommand}" />
    </VerticalStackLayout>
</ContentPage>