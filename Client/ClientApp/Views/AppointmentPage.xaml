<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.AppointmentPage"
             Title="Підтвердження запису">
    <VerticalStackLayout Padding="30" Spacing="15" MaximumWidthRequest="450">
        <Label Text="{Binding ScheduleInfo}" FontSize="18" FontAttributes="Bold" />
        <Entry Placeholder="ПІБ пацієнта" Text="{Binding PatientName}" />
        <Entry Placeholder="Дата та час" Text="{Binding AppointmentDate}" />
        <Label Text="{Binding StatusMessage}" TextColor="Green" />
        <Button Text="Підтвердити запис" Command="{Binding SubmitCommand}" />
    </VerticalStackLayout>
</ContentPage>